# Copy to .env (never commit it) and fill in. `npm start`, `npm run dev`,
# `npm run register` and `npm run invite` read it. The checks need none of these.
# Steps for the Discord ones: docs/recipes/register-commands-and-invite.md

# The bot's token: Developer Portal → your app → Bot → Reset Token. Secret: never
# paste it in code, chat or a commit. If it leaks, reset it.
DISCORD_TOKEN=
# Developer Portal → your app → General Information → Application ID (a number).
DISCORD_APPLICATION_ID=
# Optional: your test server's id (Discord settings → Advanced → Developer Mode,
# then right-click the server → Copy Server ID). `npm run register` puts the
# commands there instantly instead of globally.
DEV_GUILD_ID=

# Where the SQLite database lives (created on first start). Default: .data/bot.db
DATABASE_PATH=
# debug | info (default) | warn | error
LOG_LEVEL=
# json (default: one JSON object per line, for servers) | pretty (for your terminal)
LOG_FORMAT=
